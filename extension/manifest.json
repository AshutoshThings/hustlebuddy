{
  "manifest_version": 3,
  "name": "HustleBuddy Job Tracker",
  "version": "1.1.0",
  "description": "Detect the job you're looking at and log it to HustleBuddy.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:3000/*"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/extension-auth*"],
      "js": ["auth-relay.js"],
      "run_at": "document_idle"
    }
  ]
}
