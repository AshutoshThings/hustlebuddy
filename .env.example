# Copy to .env.local and fill in. Never commit real values.

# --- Database ---
# Local Postgres (recommended for development; required for tests):
DATABASE_URL=postgres://localhost/hustlebuddy_dev
DATABASE_SSL=disable                 # only honored for localhost URLs
# Supabase instead:
# DATABASE_URL=postgresql://<user>:<password>@<region>.pooler.supabase.com:6543/postgres
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DATABASE_LISTEN_URL=               # optional: session-mode URL for live updates

# --- Auth (long random strings, different from each other) ---
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Google sign-in (optional locally) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=               # optional; never a localhost URL on a server

# --- Email: signup and password-reset codes (Mailjet) ---
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# MAILJET_SENDER_EMAIL=

# --- Resume storage (Supabase, private "resumes" bucket) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ---
# SSE_MAX_SECONDS=270                # max life of a live-update stream
